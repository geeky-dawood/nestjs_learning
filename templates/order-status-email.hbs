<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order Status Update</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f9f9f9;
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 500px;
            margin: auto;
            background: #fff;
            padding: 25px;
            border: 1px solid #ddd;
        }

        .header {
            text-align: center;
            margin-bottom: 20px;
        }

        .order-box {
            margin-top: 15px;
            padding: 12px;
            background-color: #f4f6f8;
            border-left: 4px solid #007bff;
            font-size: 14px;
        }

        .status {
            margin-top: 15px;
            padding: 12px;
            font-weight: bold;
            border-radius: 4px;
            background: #e0f2fe;
            color: #0369a1;
        }

        .footer {
            margin-top: 25px;
            font-size: 12px;
            color: #777;
            text-align: center;
        }
    </style>
</head>

<body>
    <div class="container">

        <div class="header">
            <h2>Order Status Update</h2>
        </div>

        <p>Hello {{name}},</p>

        <p>Your order status has been updated.</p>

        <!-- Order Number -->
        <div class="order-box">
            <strong>Order Number:</strong> {{orderNumber}}
        </div>

        <!-- Status -->
        <div class="status">
            Status: {{status}}
        </div>

        <!-- Optional message -->
        {{#if message}}
        <p style="margin-top: 12px;">{{message}}</p>
        {{/if}}

        <p style="margin-top: 15px;">
            If you have any questions, feel free to contact us.
        </p>

    

    </div>
</body>

</html>