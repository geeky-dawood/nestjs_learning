<!DOCTYPE html>
<html lang="{{lang}}">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}}</title>

    <style>
        body {
            font-family: Arial;
            background: #f9f9f9;
            padding: 20px;
        }

        .container {
            max-width: 500px;
            margin: auto;
            background: #fff;
            padding: 25px;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        .header {
            text-align: center;
            margin-bottom: 20px;
        }

        .order-box {
            margin-top: 15px;
            padding: 12px;
            background: #f4f6f8;
            border-left: 4px solid #007bff;
        }

        .status {
            margin-top: 15px;
            padding: 12px;
            font-weight: bold;
            background: #e0f2fe;
            color: #0369a1;
        }

        .footer {
            margin-top: 25px;
            font-size: 12px;
            color: #777;
            text-align: center;
        }
    </style>
</head>

<body>
    <div class="container">

        <div class="header">
            <h2>{{title}}</h2>
        </div>

        <p>{{greeting}} {{name}},</p>

        <p>{{statusUpdatedMessage}}</p>

        <div class="order-box">
            <strong>{{orderNumberLabel}}:</strong> {{orderNumber}}
        </div>

        <div class="status">
            {{statusLabel}}: {{status}}
        </div>

        {{#if message}}
        <p>{{message}}</p>
        {{/if}}

        <p>{{supportMessage}}</p>

        <div class="footer">
            {{footerText}}
        </div>

    </div>
</body>

</html>