generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum SigninResponseEnum {
  PASSWORD_MATCHES
  INVALID_PASSWORD
}

enum OrderStatusEnum {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum UserRole {
  ADMIN
  USER
}

enum ActivityActionType {
  ORDER_CREATED
  ORDER_STATUS_UPDATED
  ORDER_CANCELLED
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  dob             String?
  password        String
  profile_picture String?
  is_deleted      Boolean  @default(false)
  is_verified     Boolean  @default(false)
  role            UserRole @default(USER)

  wrong_attempts Int       @default(0)
  is_locked      Boolean   @default(false)
  lock_until     DateTime?

  address  Address[]
  attempts LoginAttempts[]

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model LoginAttempts {
  id              String             @id @default(uuid())
  reason          SigninResponseEnum
  attempt_success Boolean            @default(false)

  user_id String
  user    User   @relation(fields: [user_id], references: [id])

  createAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("login_attempts")
}

model Order {
  id           String          @id @default(uuid())
  order_number String
  total_price  Int
  order_status OrderStatusEnum @default(PENDING)

  items OrderItem[]

  user    User   @relation(fields: [user_id], references: [id])
  user_id String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model Product {
  id          String  @id @default(uuid())
  title       String
  description String
  price       Int
  category    String?
  quantity    Int
  is_deleted  Boolean @default(false)

  orders OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model OrderItem {
  id String @id @default(uuid())

  order_id   String
  product_id String

  quantity Int
  price    Int

  order   Order   @relation(fields: [order_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])

  @@map("order_items")
}

model ActivityLogs {
  id String @id @default(uuid())

  user_id  String
  order_id String?

  previous_status OrderStatusEnum?
  current_status  OrderStatusEnum?

  action_type ActivityActionType
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("activity_logs")
}

model Address {
  id             String  @id @default(uuid())
  latitude       Float
  longitude      Float
  country        String
  city           String
  state          String
  zip_code       String
  address        String
  address_line_1 String?
  address_line_2 String?
  tag            String?

  is_Deleted  Boolean @default(false)
  is_Verified Boolean @default(false)

  user_id String
  user    User   @relation(fields: [user_id], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("address")
}
